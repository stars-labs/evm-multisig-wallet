# Test Environment Configuration
NODE_ENV=test
LOG_LEVEL=warn
PORT=3001
HOST=0.0.0.0

# Test Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=multisig_validator_test
DB_USER=validator_user
DB_PASSWORD=validator_password
DB_SSL=false

# Security
JWT_SECRET=test-jwt-secret-key-that-is-very-long-and-secure-for-testing-purposes-only

# Test Blockchain Configuration
LOCALHOST_RPC_URL=http://127.0.0.1:8545
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/test-key

# Test Slack Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/test/webhook/url
SLACK_WEBHOOK_URL_PRIVATE=https://hooks.slack.com/test/private/webhook/url
SLACK_DEFAULT_CHANNEL=#multisig-noti-test

# Test Contract Address
TEST_MULTISIG_ADDRESS=0x0165878A594ca255338adfa4d48449f69242Eb8F

# Disable real notifications in tests
ENABLE_NOTIFICATIONS=false
ENABLE_SLACK=false

# Test-specific settings
DEBUG_TESTS=false
TEST_TIMEOUT=30000